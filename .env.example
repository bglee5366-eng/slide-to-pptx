# 서버 전용 비밀값만 작성하세요. NEXT_PUBLIC_ 접두사는 브라우저에 노출됩니다.
CONVERSION_API_KEY=

# 슬라이드 분석용 서버 전용 설정
# openai-compatible | gemini | claude | local(=Ollama)
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_API_BASE_URL=https://api.openai.com/v1/chat/completions
AI_TIMEOUT_MS=60000
# Tesseract.js 한국어+영어 OCR 좌표 보정 사용 여부
AI_OCR=0
# 작은 텍스트를 위한 Gemini 2차 텍스트 재검사
AI_TEXT_RECHECK=0

# Gemini 사용 시
GEMINI_API_KEY=
# Google AI Studio에서 발급한 키를 GOOGLE_API_KEY로 등록해도 됩니다.
# GOOGLE_API_KEY=
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent

# Claude 사용 시
ANTHROPIC_API_KEY=
# CLAUDE_API_BASE_URL=https://api.anthropic.com/v1/messages
CLAUDE_MAX_TOKENS=8192

# 로컬 모델 사용 시(Ollama 기본값)
# LOCAL_AI_BASE_URL=http://localhost:11434/api/chat
# LOCAL_AI_API_KEY=
